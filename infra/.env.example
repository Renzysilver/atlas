# ATLAS — Environment variables for local Docker Compose deployment
# Copy this file to .env and fill in your API keys.

# --- DATABASE (real Postgres from docker-compose.yml) ---
DATABASE_URL=postgresql://atlas:atlas_dev@localhost:5432/atlas

# --- QUEUE (real Redis from docker-compose.yml) ---
REDIS_URL=redis://localhost:6379
QUEUE_CONCURRENCY=4

# --- ATLAS API ---
ATLAS_API_PORT=4001
ATLAS_API_LOG_LEVEL=info

# --- API-Football (GET YOUR KEY at https://www.api-football.com/) ---
API_FOOTBALL_KEY=YOUR_API_FOOTBALL_KEY_HERE
API_FOOTBALL_HOST=v3.football.api-sports.io
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_DAILY_LIMIT=100
API_FOOTBALL_SEASON=2025
API_FOOTBALL_LEAGUE_ID=39

# --- Groq (https://console.groq.com/keys) ---
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
GROQ_MODEL=llama-3.3-70b-versatile

# --- Resend (https://resend.com/api-keys) ---
RESEND_API_KEY=
DAILY_REPORT_RECIPIENT=vali@example.com
DAILY_REPORT_SENDER=atlas@yourdomain.com

# --- Weather API (https://openweathermap.org/api) ---
WEATHER_API_KEY=

# --- Odds API (https://the-odds-api.com/) ---
ODDS_API_KEY=

# --- Cron schedules (per spec Section 2) ---
DAILY_REPORT_CRON="0 5 * * *"
COLLECTOR_FIXTURES_CRON="0 */6 * * *"
COLLECTOR_DAILY_CRON="0 4 * * *"
COLLECTOR_LINEUPS_CRON="*/10 * * * *"

# --- ATLAS Constitution Flags (do NOT change in production) ---
ATLAS_NEVER_FABRICATE=true
ATLAS_LOG_EVERY_PREDICTION=true

# --- Dashboard ---
NEXT_PUBLIC_ATLAS_API_PORT=4001
