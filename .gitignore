# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (NEVER commit — use infra/.env.example as the template)
.env
.env.*
!.env.example

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log

# Skills directory
/skills/

# ATLAS-specific ignores
# SQLite runtime database (sandbox dev) — runtime data, not source
/db/*.db
/db/*.db-journal
# User uploads (PDFs, etc.) — not part of source
/upload/
# Sandbox dev automation scripts — environment-specific, not part of ATLAS
/.zscripts/
# bun cache
/.bun/
# Python venv (for future simulation service)
/.venv/
/__pycache__/
